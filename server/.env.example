[TEMPLATE]
# Required in production (Render). Local dev can use a local MongoDB.
MONGODB_URI=mongodb://localhost:27017/admitbridge

# Required — used to sign login tokens. Use a long random string.
JWT_SECRET=change_me_to_a_long_random_string

# Port for the Express server. Render injects its own PORT automatically.
PORT=5001

# URL of the ML prediction service (Render blueprint wires this automatically).
# Leave unset to use the local default http://localhost:8000
ML_SERVICE_URL=http://localhost:8000

# Optional — enables Google sign-in
GOOGLE_CLIENT_ID=your_google_client_id_here
